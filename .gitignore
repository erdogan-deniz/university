# ── Общий блок репозиториев с сервером ──
# Только нейтральное: служебные файлы лежат в .git/info/exclude, не здесь.

# Аварийные дампы Git Bash / MSYS — появляются в корне сами, содержимого не несут.
*.stackdump

# Системный мусор Windows / macOS, временные файлы редакторов и Office.
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*.tmp
*.bak
*~
~$*
nul
# ── конец общего блока ──

# ── Правила этого проекта ──

# Белый список (решение Дениза 23.09.2026): на верхнем уровне закрыто всё, кроме явно
# открытого. Remote публичный, а в проекте лежат приказы, справки, ФИО группы и
# преподавателей. Новая папка по умолчанию остаётся дома; выложить её — дописать строку
# `!/<папка>/`. Ошибка здесь значит «забыл выложить», а не «выложил лишнее».
# Дома остаются: служебное (правила, беклог, идеи, ящики),
# semesters/, group/, status/, documents/, postgraduate/, deferred/.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/bachelor/
!/master/
!/thesis/

# Внутри открытых папок. Практика магистратуры: наружу только отчёты за 2 семестр
# (метаданные вычищены 30.09.2026, выложены по слову Дениза 01.10.2026). Письмо
# руководителю, заметки и суммы — дома; практика текущего семестра — дома целиком,
# там ФИО третьих лиц.
/master/internships/*
!/master/internships/semester-2/
/master/internships/semester-2/README.md
/master/internships/semester-2/04-letter-to-supervisor.txt
/master/internships/semester-2/SHA256SUMS

# Сборка .NET и C++
bin/
obj/
packages/
.vs/
Debug/
Release/
*.pdb
*.suo
*.aps
*.obj
*.ilk
*.idb
*.res
*.tlog
*.recipe
*.lastbuildstate

# Зависимости, которые ставятся по манифесту
vendor/
node_modules/
.venv/
venv/
__pycache__/
*.egg-info/

# Сборка документации
docs/_build/

# Бинарные зависимости: в репозиторий не кладём, см. SETUP.md рядом с проектами
*.dll
*.exe
*.lib
*.so
*.pyd

# Локальные настройки и секреты
.env
*.user

# Служебные метки Windows
*:Zone.Identifier
